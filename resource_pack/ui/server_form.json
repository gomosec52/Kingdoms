{
  "namespace": "server_form",
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'kingdoms:settlement') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "kingdoms_long_form_root@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "server_form.kingdoms_title_label",
    "$title_size": [
      "100% - 15px",
      14
    ],
    "$title_max_size": [
      "100% - 15px",
      14
    ],
    "$child_control": "server_form.kingdoms_long_form_panel",
    "size": [
      310,
      230
    ],
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'kingdoms:settlement') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "kingdoms_title_label": {
    "type": "label",
    "text": "Войны королевств",
    "font_size": "large",
    "font_scale_factor": 0.82,
    "shadow": true,
    "color": [
      0.95,
      0.82,
      0.48
    ],
    "text_alignment": "center",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [
      "100%",
      "default"
    ]
  },
  "kingdoms_long_form_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "info_scroll@common.scrolling_panel": {
          "$show_background": false,
          "size": [
            "100%",
            94
          ],
          "offset": [
            0,
            0
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$scrolling_content": "server_form.kingdoms_info_content",
          "$scroll_size": [
            4,
            "100% - 4px"
          ],
          "$scrolling_pane_size": [
            "100% - 6px",
            "100%"
          ],
          "$scrolling_pane_offset": [
            2,
            0
          ],
          "$scroll_bar_right_padding_size": [
            0,
            0
          ]
        }
      },
      {
        "button_scroll@common.scrolling_panel": {
          "$show_background": false,
          "size": [
            "100%",
            "100% - 98px"
          ],
          "offset": [
            0,
            98
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$scrolling_content": "server_form.kingdoms_buttons_content",
          "$scroll_size": [
            4,
            "100% - 4px"
          ],
          "$scrolling_pane_size": [
            "100% - 6px",
            "100%"
          ],
          "$scrolling_pane_offset": [
            2,
            0
          ],
          "$scroll_bar_right_padding_size": [
            0,
            0
          ]
        }
      }
    ]
  },
  "kingdoms_info_content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100% - 4px",
      "100%c"
    ],
    "controls": [
      {
        "heading": {
          "type": "label",
          "text": "Сведения о поселении",
          "font_size": "small",
          "font_scale_factor": 0.75,
          "shadow": true,
          "color": "$main_header_text_color",
          "size": [
            "100%",
            "default"
          ]
        }
      },
      {
        "info_text": {
          "type": "label",
          "text": "#form_text",
          "font_size": "small",
          "font_scale_factor": 0.68,
          "line_padding": 1,
          "color": "$main_header_text_color",
          "size": [
            "100%",
            "default"
          ]
        }
      }
    ]
  },
  "kingdoms_buttons_content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100% - 4px",
      "100%c"
    ],
    "offset": [
      2,
      0
    ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.kingdoms_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "kingdoms_dynamic_button": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      31
    ],
    "controls": [
      {
        "icon_panel": {
          "type": "panel",
          "size": [
            30,
            "100%c"
          ],
          "bindings": [
            {
              "source_control_name": "icon",
              "resolve_sibling_scope": true,
              "binding_type": "view",
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "icon": {
                "type": "image",
                "layer": 2,
                "size": [
                  24,
                  24
                ],
                "offset": [
                  0,
                  2
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "progress@progress.progress_loading_bars": {
                "size": [
                  24,
                  4
                ],
                "offset": [
                  0,
                  14
                ],
                "bindings": [
                  {
                    "source_control_name": "icon",
                    "resolve_sibling_scope": true,
                    "binding_type": "view",
                    "source_property_name": "(#texture = 'loading')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            "fill",
            30
          ],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [
            "100%",
            20
          ],
          "layer": 4,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "kingdoms_server_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.kingdoms_long_form_root"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
