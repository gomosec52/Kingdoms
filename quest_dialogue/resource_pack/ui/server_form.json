{
  "namespace": "server_form",
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'quests:dialogue') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "quests_server_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.quests_dialogue_root"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "quests_dialogue_root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "layer": 60,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'quests:dialogue') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "bottom_bar": {
          "type": "panel",
          "size": ["100%", "25%"],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 2,
          "controls": [
            {
              "dim": {
                "type": "image",
                "texture": "textures/ui/Black",
                "alpha": 0.55,
                "size": ["100%", "100%"],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 0
              }
            },
            {
              "panel_bg": {
                "type": "image",
                "texture": "textures/ui/dialogue_panel",
                "alpha": 0.75,
                "size": ["100%", "100%"],
                "anchor_from": "center",
                "anchor_to": "center",
                "nineslice_size": 8,
                "layer": 1
              }
            },
            {
              "dialogue_scroll@common.scrolling_panel": {
                "$show_background": false,
                "size": ["100% - 28px", "100% - 52px"],
                "offset": [14, 10],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "$scrolling_content": "server_form.quests_dialogue_body",
                "$scroll_size": [4, "100% - 4px"],
                "$scrolling_pane_size": ["100% - 8px", "100%"],
                "$scrolling_pane_offset": [0, 0],
                "$scroll_bar_right_padding_size": [0, 0],
                "layer": 3
              }
            },
            {
              "buttons_wrap": {
                "type": "panel",
                "size": [220, 40],
                "offset": [-12, -10],
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "layer": 5,
                "controls": [
                  {
                    "form_buttons@server_form.quests_buttons_content": {
                      "size": ["100%", "100%"],
                      "anchor_from": "bottom_right",
                      "anchor_to": "bottom_right"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "quests_dialogue_body": {
    "type": "panel",
    "controls": [
      {
        "text_label": {
          "type": "label",
          "text": "#form_text",
          "font_size": "large",
          "font_scale_factor": 1.2,
          "color": [0.94, 0.94, 0.96],
          "shadow": true,
          "text_alignment": "left",
          "size": ["100%", "default"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      }
    ]
  },
  "quests_buttons_content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "100%"],
    "controls": [
      {
        "buttons_factory": {
          "type": "factory",
          "max_size": ["100%", "100%"],
          "control_ids": {
            "form_button": "@server_form.quests_form_button"
          },
          "bindings": [
            {
              "binding_name": "#form_button_length",
              "binding_name_override": "#collection_length",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },
  "quests_form_button@common_buttons.light_text_button": {
    "$pressed_button_name": "button.form_button_click",
    "$default_button_texture": "textures/ui/button_borderless_light",
    "$hover_button_texture": "textures/ui/button_borderless_lighthover",
    "$pressed_button_texture": "textures/ui/button_borderless_lightpressed",
    "$locked_button_texture": "textures/ui/button_borderless_light",
    "$button_text": "#form_button_text",
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$button_text_max_size": ["100% - 8px", 20],
    "size": [100, 32],
    "offset": [4, 0],
    "layer": 4,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  }
}
