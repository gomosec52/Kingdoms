{
  "namespace": "server_form",

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'quests:dialogue') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "quests_server_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.quests_dialogue_root"
                }
              }
            }
          }
        ]
      }
    ]
  },

  "quests_dialogue_root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "layer": 80,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'quests:dialogue') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "bottom_panel": {
          "type": "panel",
          "size": ["100%", "28%"],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "controls": [
            {
              "bg_black": {
                "type": "image",
                "texture": "textures/ui/Black",
                "alpha": 0.62,
                "size": ["100%", "100%"],
                "layer": 0
              }
            },
            {
              "bg_panel": {
                "type": "image",
                "texture": "textures/ui/dialogue_panel",
                "alpha": 0.85,
                "size": ["100%", "100%"],
                "nineslice_size": 8,
                "layer": 1
              }
            },
            {
              "dialogue_label": {
                "type": "label",
                "text": "#form_text",
                "font_size": "large",
                "font_scale_factor": 1.35,
                "line_padding": 2,
                "shadow": true,
                "color": [0.95, 0.95, 0.97],
                "text_alignment": "left",
                "size": ["100% - 160px", "100% - 24px"],
                "offset": [16, 10],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 4,
                "bindings": [{ "binding_name": "#form_text" }]
              }
            },
            {
              "buttons_area": {
                "type": "panel",
                "size": [140, "100% - 16px"],
                "offset": [-12, 0],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle",
                "layer": 5,
                "controls": [
                  {
                    "buttons_grid@server_form.quests_buttons_grid": {
                      "size": ["100%", "100%"],
                      "anchor_from": "center",
                      "anchor_to": "center"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "quests_buttons_grid": {
    "type": "grid",
    "size": ["100%", "100%"],
    "grid_dimensions": [1, 3],
    "maximum_grid_items": 3,
    "grid_item_template": "server_form.quests_dynamic_button",
    "grid_fill_direction": "vertical",
    "collection_name": "form_buttons"
  },

  "quests_dynamic_button": {
    "type": "panel",
    "size": ["100%", 36],
    "controls": [
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "$default_button_texture": "textures/ui/button_borderless_dark",
          "$hover_button_texture": "textures/ui/button_borderless_darkhover",
          "$pressed_button_texture": "textures/ui/button_borderless_darkpressed",
          "$locked_button_texture": "textures/ui/button_borderless_dark",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": ["100% - 10px", 18],
          "size": ["100% - 4px", 32],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 4,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
